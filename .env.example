# Production (Vercel): Turso. When TURSO_DATABASE_URL is set it wins over
# DATABASE_URL everywhere (app, seed, schema scripts).
TURSO_DATABASE_URL="libsql://nikia-tohid.aws-us-east-2.turso.io"
TURSO_AUTH_TOKEN="eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3OTAyNjQwMDgsImlkIjoiMDFhMGQ0MGMtYTgwMS03OWJjLWEwYTctMjc0ZmJiNGVlYzA0Iiwia2lkIjoiLUNmTlRxZmxIcDVLVTRweW5CTnZjN0tkU0YxemxFNWI1LXY0UkoyWlpGQSIsInJpZCI6ImI4MWFkMWJmLWRiY2EtNGViYi05M2I0LWNlYmJkZTViMmRmMCJ9.P5fENWQTULP4uGPJWz1Jvz0YrnXK6zD02pRICOf0ogVD9ItMoSzy7V2-OrPBmYqIkYoJx5egLiNqeiPnDzcxCg"

# ─── Auth (Better Auth) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The public URL of the site (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Extra origins allowed to call the auth API, comma-separated
# (e.g. the www. variant or a preview domain).
BETTER_AUTH_TRUSTED_ORIGINS=""

# ─── SMS OTP (sms.ir "verify" template). Empty = codes are printed to the
# server console instead of being sent (development only).
SMSIR_API_KEY=""
SMSIR_VERIFY_TEMPLATE_ID=""
SMSIR_VERIFY_PARAM_NAME="code"

# ─── Payment gateway ─────────────────────────────────────────────────
# Empty = local payment simulator (blocked in production unless
# ALLOW_PAYMENT_SIMULATOR=true). "zarinpal" is built in.
PAYMENT_PROVIDER="zarinpal"
PAYMENT_GATEWAY_MERCHANT_ID=""
# true → use ZarinPal's sandbox endpoints.
PAYMENT_GATEWAY_SANDBOX="false"
# Only for staging demos: lets a production build use the fake gateway.
ALLOW_PAYMENT_SIMULATOR="false"

# ─── Image storage (ArvanCloud Object Storage, S3-compatible) ────────
ARVAN_ENDPOINT="https://s3.ir-thr-at1.arvanstorage.ir"
ARVAN_BUCKET="nikia"
ARVAN_ACCESS_KEY="7d5ce391-978b-4291-8692-6d6d80f94303"
ARVAN_SECRET_KEY="9a4ecdbc9b69697ff8dc734b70d5df36d8df6b4f3875576caeebc917827b1a27"
# Optional custom domain / CDN in front of the bucket.
ARVAN_PUBLIC_URL_BASE=""

# ─── Cron (Vercel Cron sends this as a Bearer token) ─────────────────
CRON_SECRET=""
